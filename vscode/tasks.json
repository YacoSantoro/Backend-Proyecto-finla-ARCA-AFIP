{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Levantar todo (back + front)",
      "dependsOn": ["Backend: levantar", "Frontend: levantar"],
      "problemMatcher": []
    },
    {
      "label": "Backend: levantar",
      "type": "shell",
      "command": ".\\mvnw.cmd spring-boot:run",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Frontend: npm install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Frontend: start",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Frontend: levantar",
      "dependsOrder": "sequence",
      "dependsOn": ["Frontend: npm install", "Frontend: build", "Frontend: start"],
      "problemMatcher": []
    }
  ]
}
